def main():
    jadval_yaratish(cursor)

    while True:
        print("\n1 - Talaba qoshmoqchimisiz?")
        print("2 - Top talabalar")
        print("3 - Eng yomon talabalar")
        print("4 - Talaba qidirish (ism bilan)")
        print("5 - Chiqish")

        choice = input("Tanlov: ")

        if choice == "1":
            talabalar_qoshish(cursor)
        elif choice == "2":
            top_student(cursor)
        elif choice == "3":
            bad_students(cursor)
        elif choice == "4":
            search_student(cursor)
        elif choice == "5":
            print(" TUGADI ")
            break
        else:
            print("BOR NARSANI TANLA AXMOQ")

    connection.close()  


if __name__ == "__main__":
    main()
