def talabalar_qoshish(cursor):
    cursor.execute("SELECT COUNT(*) FROM talabalar")
    talabalar_soni = cursor.fetchone()[0]
    if talabalar_soni < 10:
        ism = input("Talabaning ismi: ")
        familya = input("Talabaning familyasi: ")
        yosh = int(input("Talabaning yoshi : "))
        fan  = input("Talabani fani: ")
        baholar = int(input("Talabaning bahosi: "))
        cursor.execute('''
        INSERT INTO talabalar(ism, familya, yosh, fan, baholar) VALUES (?,?,?,?,?)
        ''', (ism,familya,yosh,fan,baholar) )
        connection.commit()
        print("Talaba qoshildi !")


def top_student(cursor):
    cursor.execute(''' 
        SELECT * FROM talabalar ORDER BY baho DESC LIMIT 1
    ''')
    student = cursor.fetchone()
    if student:
        print("Eng yuqori baho olgan talaba:", student)
        for s in student:
            print(s)
    else: 
        print("talaba yoq")



def bad_students(cursor):
    cursor.execute(''' 
        SELECT * FROM talabalar ORDER BY baho ASC LIMIT 1
    ''')
    student = cursor.fetchone()
    if student:
        print("Eng pas baho olgan talaba:", student)

    else:
        print("talaab yoq")


def search_student(cursor):
    ism_qidiruv = input("Qidirilayotgan talaba ismi: ")
    cursor.execute(
        """
        SELECT * FROM talabalar WHERE ism LIKE ?
    """,
        (f"{ism_qidiruv}",)
    )
    students = cursor.fetchone()
    if students:
        print("Topildi Talaba: ")
        
    else:
        print("Bunday ismli talaba yoq ")


