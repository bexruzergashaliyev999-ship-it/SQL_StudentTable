import sqlite3

connection = sqlite3.connect("maktab.db")
cursor = connection.cursor()


def jadval_yaratish(cursor):
    cursor.execute(""" CREATE TABLE IF NOT EXISTS talabalar(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        ism TEXT NOT NULL,
        familiya TEXT NOT NULL,
        yosh INTEGER NOT NULL CHECK(yosh > 6 AND yosh < 18),
        fan TEXT NOT NULL,
        baho INTEGER NOT NULL CHECK(baho BETWEEN 1 AND 5)
    ) """)
    connection.commit()
    print("Table created successfully!")


def talabalar_qoshish(cursor):
    cursor.execute("SELECT COUNT(*) FROM talabalar")
    talabalar_soni = cursor.fetchone()[0]

    if talabalar_soni < 10:
        ism = input("Student's first name: ")
        familiya = input("Student's last name: ")
        yosh = int(input("Student's age: "))
        fan = input("Student's subject: ")
        baho = int(input("Student's grade: "))

        cursor.execute(
            """
        INSERT INTO talabalar(ism, familiya, yosh, fan, baho) VALUES (?,?,?,?,?)
        """,
            (ism, familiya, yosh, fan, baho),
        )
        connection.commit()
        print("Student added successfully!")
    else:
        print("10 students have already been added!")


def top_student(cursor):
    cursor.execute(""" 
        SELECT * FROM talabalar ORDER BY baho DESC LIMIT 1
    """)
    student = cursor.fetchone()
    if student:
        print("Top student with the highest grade:", student)
        for s in student:
            print(s)
    else:
        print("No students found.")


def bad_students(cursor):
    cursor.execute(""" 
        SELECT * FROM talabalar ORDER BY baho ASC LIMIT 1
    """)
    student = cursor.fetchone()
    if student:
        print("Student with the lowest grade:", student)
    else:
        print("No students found.")


def search_student(cursor):
    ism_qidiruv = input("Enter the name of the student to search: ")
    cursor.execute(
        """
        SELECT * FROM talabalar WHERE ism LIKE ?
    """,
        (f"%{ism_qidiruv}%",),
    )
    students = cursor.fetchone()
    if students:
        print("Student found:", students)
    else:
        print("Student not found!")


def main():
    jadval_yaratish(cursor)

    while True:
        print("\n--- Student Menu ---")
        print("1 - Add student")
        print("2 - Top student")
        print("3 - Lowest grade student")
        print("4 - Search student")
        print("5 - Exit")

        choice = input("Choice: ")

        if choice == "1":
            talabalar_qoshish(cursor)
        elif choice == "2":
            top_student(cursor)
        elif choice == "3":
            bad_students(cursor)
        elif choice == "4":
            search_student(cursor)
        elif choice == "5":
            print("GOODBYE")
            break
        else:
            print("Please choose a valid option!")

    connection.close()


if __name__ == "__main__":
    main()
